# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=your_chat_id_here

# How many pages of Unstop hackathons to scan (50 per page)
UNSTOP_MAX_PAGES=10

# Set to true to also alert on online hackathons that mention Bangalore
INCLUDE_ONLINE=false

# Optional: comma-separated public Luma/lu.ma event URLs to watch
# (Luma has no public city discovery API — this is a workaround)
# LUMA_EVENT_URLS=https://lu.ma/some-bangalore-hackathon,https://luma.com/another-event
LUMA_EVENT_URLS=
