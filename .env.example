# HackathonX bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_hackathonx_bot_token_here

# Your Telegram chat ID (shared is fine for both bots)
TELEGRAM_CHAT_ID=your_chat_id_here

# SportX bot token (@Sportx_va_bot) — required for sports alerts
SPORTX_TELEGRAM_BOT_TOKEN=your_sportx_bot_token_here
# Optional override; defaults to TELEGRAM_CHAT_ID
# SPORTX_TELEGRAM_CHAT_ID=

# Pages of Unstop hackathons to scan (50 per page)
UNSTOP_MAX_PAGES=10

# Keep this as hackathons for HackathonX
UNSTOP_TYPES=hackathons

# Set to true to also alert on online hackathons that mention Bangalore
INCLUDE_ONLINE=false

# Luma: Bengaluru discover (https://luma.com/bengaluru) is included by default.
# Add more calendars/event pages as a comma-separated list if needed.
# LUMA_EVENT_URLS=https://lu.ma/some-other-calendar
LUMA_EVENT_URLS=
