# HackathonX bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID
TELEGRAM_CHAT_ID=your_chat_id_here

# Pages of Unstop hackathons to scan (50 per page)
UNSTOP_MAX_PAGES=10

# Keep this as hackathons for HackathonX
UNSTOP_TYPES=hackathons

# Set to true to also alert on online hackathons that mention Bangalore
INCLUDE_ONLINE=false

# Optional: only add Luma URLs that are actual hackathons
# LUMA_EVENT_URLS=https://lu.ma/some-bangalore-hackathon
LUMA_EVENT_URLS=
