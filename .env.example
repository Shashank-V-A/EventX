# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=your_chat_id_here

# Pages per Unstop category (50 listings per page)
UNSTOP_MAX_PAGES=5

# Unstop opportunity types to scan
UNSTOP_TYPES=hackathons,competitions,quizzes,conferences,workshops

# Set to true to also alert on online listings that mention Bangalore
INCLUDE_ONLINE=false

# Optional: comma-separated public Luma/lu.ma event URLs to watch
# LUMA_EVENT_URLS=https://lu.ma/some-bangalore-event
LUMA_EVENT_URLS=
